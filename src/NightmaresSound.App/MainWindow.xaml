<Window x:Class="NightmaresSound.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NightmaresSound.App"
        Title="Retro Sounds Generator 1.2 · Nightmares Studio" Width="1320" Height="880" MinWidth="880" MinHeight="520"
        WindowStartupLocation="CenterScreen" Language="en-US"
        Background="{DynamicResource TextureBrush}" Style="{StaticResource {x:Type Window}}">
    <Window.InputBindings>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RandomizeCommand}" />
        <KeyBinding Key="F5" Command="{Binding PlayCommand}" />
        <KeyBinding Key="Escape" Command="{Binding StopCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveRecipeCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenRecipeCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
        <local:InstrumentLabelConverter x:Key="InstrumentLabel" />
        <DataTemplate x:Key="InstrumentOption"><TextBlock Text="{Binding Converter={StaticResource InstrumentLabel}}" /></DataTemplate>
        <DataTemplate DataType="{x:Type local:NumberParameter}">
            <Grid Margin="0,3" ToolTip="{Binding TeachingDescription}" ToolTipService.ShowOnDisabled="True" MinHeight="32" local:Semantic.Concept="{Binding Concept}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" /><ColumnDefinition Width="*" MinWidth="45" />
                    <ColumnDefinition Width="76" /><ColumnDefinition Width="37" />
                </Grid.ColumnDefinitions>
                <Border BorderThickness="3,0,0,0" BorderBrush="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=(local:Semantic.Accent)}" Padding="7,0,0,0">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="12" />
                </Border>
                <local:BoundedSlider Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                        SmallChange="{Binding Step}" LargeChange="{Binding Step}" TickFrequency="{Binding Step}"
                        Value="{Binding SliderValue, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" Margin="2,0,8,0" VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding Label}" />
                <TextBox Grid.Column="2" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}"
                         AutomationProperties.Name="{Binding Label}" MinWidth="68" />
                <TextBlock Foreground="{DynamicResource MutedBrush}" Grid.Column="3" Text="{Binding Unit}" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="11" />
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="14" Background="Transparent">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Retro Sounds Generator 1.2" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,3" />
            <TextBlock Foreground="{DynamicResource MutedBrush}" Text="NIGHTMARES  /  SOUND STUDIO     ·     Choose · Randomize · Shape · Export WAV" Margin="0,0,0,12" />
            <WrapPanel Margin="0,0,0,4">
                <Button Content="_Randomize" BorderBrush="{DynamicResource TimbreBrush}" Command="{Binding RandomizeCommand}" FontWeight="Bold" ToolTip="Create a variation in the selected category (Ctrl+R)" />
                <Button Content="_Play" BorderBrush="{DynamicResource OutputBrush}" Command="{Binding PlayCommand}" ToolTip="Play the current exported buffer (F5)" />
                <Button Content="S_top" Command="{Binding StopCommand}" Margin="0,0,14,6" ToolTip="Stop playback (Esc)" />
                <Button Content="_Undo" Command="{Binding UndoCommand}" ToolTip="Undo an edit or randomization (Ctrl+Z)" />
                <Button Content="_Redo" Command="{Binding RedoCommand}" Margin="0,0,14,6" ToolTip="Redo (Ctrl+Y)" />
                <Button Content="_Save recipe" Command="{Binding SaveRecipeCommand}" ToolTip="Save settings as JSON (Ctrl+S)" />
                <Button Content="_Open recipe" Command="{Binding OpenRecipeCommand}" Margin="0,0,14,6" ToolTip="Open saved settings (Ctrl+O)" />
                <Button Content="_Export WAV" BorderBrush="{DynamicResource OutputBrush}" Command="{Binding ExportCommand}" FontWeight="Bold" ToolTip="Save the current sound as a 16-bit PCM WAV (Ctrl+E)" />
            </WrapPanel>
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource ErrorBrush}" FontWeight="Bold" Margin="0,0,0,5" />
        </StackPanel>
        <StatusBar DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.72*" MinWidth="195" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="2.2*" MinWidth="375" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="0.88*" MinWidth="255" />
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,3,0">
                    <TextBlock Text="1. Choose a starting point" TextWrapping="Wrap" Style="{StaticResource SectionHeading}" />
                    <Label Content="Search all configurations" Target="{Binding ElementName=SearchBox}" Padding="0,0,0,4" />
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                    <TextBlock Text="Category" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                             AutomationProperties.Name="Sound category" MaxHeight="360" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,14">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource SelectableItem}"><Setter Property="Padding" Value="4,5" /></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Starting configuration" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <ListBox ItemsSource="{Binding VisibleProfiles}" SelectedItem="{Binding SelectedProfile}"
                             AutomationProperties.Name="Starting configuration" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="280">
                        <ListBox.ItemTemplate>
                            <DataTemplate><StackPanel Margin="4,6">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Foreground="{DynamicResource MutedBrush}" Text="{Binding Description}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding EmptySearchHint}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="Explore Instruments · Medieval for retro voices, acoustic recordings, and short musical phrases." TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12" />
                </StackPanel>
            </ScrollViewer>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="{DynamicResource ControlBorderBrush}" />
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="2. Shape your sound" Style="{StaticResource SectionHeading}" />
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="9,7" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="COLOR GUIDE · What each control shapes" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
                            <WrapPanel x:Name="ConceptLegend">
                                <TextBlock Text="● Pitch &amp; music" Foreground="{DynamicResource PitchBrush}" Margin="0,0,14,4" />
                                <TextBlock Text="● Timbre &amp; effects" Foreground="{DynamicResource TimbreBrush}" Margin="0,0,14,4" />
                                <TextBlock Text="● Timing &amp; envelopes" Foreground="{DynamicResource TimingBrush}" Margin="0,0,14,4" />
                                <TextBlock Text="● Levels &amp; output" Foreground="{DynamicResource OutputBrush}" Margin="0,0,0,4" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding ProfileDescription}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <GroupBox Header="Instruments · Medieval" Visibility="{Binding IsInstrument, Converter={StaticResource BooleanVisibility}}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TimbreBrush}" Text="Instrument" />
                            <ComboBox ItemsSource="{Binding Instruments}" SelectedItem="{Binding SelectedInstrument}" DisplayMemberPath="Name" AutomationProperties.Name="Instrument" Margin="0,4,0,8" />
                            <TextBlock Foreground="{DynamicResource TimbreBrush}" Text="Sound style" />
                            <ComboBox ItemsSource="{Binding InstrumentStyles}" SelectedItem="{Binding InstrumentStyle, ValidatesOnExceptions=True}" AutomationProperties.Name="Instrument style" Margin="0,4,0,8" />
                            <TextBlock Text="{Binding InstrumentHelp}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8" />
                            <TextBlock Text="Mode" />
                            <ComboBox ItemsSource="{Binding InstrumentModes}" ItemTemplate="{StaticResource InstrumentOption}" SelectedItem="{Binding InstrumentMode, ValidatesOnExceptions=True}" AutomationProperties.Name="Instrument mode" Margin="0,4,0,8" />
                            <StackPanel IsEnabled="{Binding IsPitchedInstrument}">
                                <TextBlock Foreground="{DynamicResource PitchBrush}" Text="Key · root note" />
                                <ComboBox ItemsSource="{Binding MusicalKeys}" SelectedIndex="{Binding InstrumentKey, ValidatesOnExceptions=True}" AutomationProperties.Name="Instrument key" Margin="0,4,0,8" />
                                <TextBlock Foreground="{DynamicResource PitchBrush}" Text="Octave" />
                                <ComboBox ItemsSource="{Binding InstrumentOctaves}" SelectedItem="{Binding InstrumentOctave, ValidatesOnExceptions=True}" AutomationProperties.Name="Instrument octave" Margin="0,4,0,8" />
                            </StackPanel>
                            <StackPanel IsEnabled="{Binding IsInstrumentPhrase}">
                                <TextBlock Foreground="{DynamicResource PitchBrush}" Text="Phrase · two bars in 4/4" />
                                <ComboBox ItemsSource="{Binding InstrumentPhrases}" ItemTemplate="{StaticResource InstrumentOption}" SelectedItem="{Binding InstrumentPhrase, ValidatesOnExceptions=True}" AutomationProperties.Name="Instrument phrase" Margin="0,4,0,8" />
                                <StackPanel IsEnabled="{Binding IsPitchedInstrument}">
                                    <TextBlock Foreground="{DynamicResource PitchBrush}" Text="Scale" />
                                    <ComboBox ItemsSource="{Binding MusicalScales}" ItemTemplate="{StaticResource InstrumentOption}" SelectedItem="{Binding InstrumentScale, ValidatesOnExceptions=True}" AutomationProperties.Name="Instrument scale" Margin="0,4,0,8" />
                                </StackPanel>
                                <ContentControl Content="{Binding InstrumentTempoParameter}" />
                            </StackPanel>
                            <TextBlock Text="Notes overlap naturally. Duration includes a protected release tail; phrase loops repeat exactly two bars. Preview and export use the same audio." TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Simple controls">
                        <ItemsControl ItemsSource="{Binding SimpleParameters}" />
                    </GroupBox>
                    <TextBlock Text="Detailed synthesis" Visibility="{Binding IsSynthesis, Converter={StaticResource BooleanVisibility}}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,4" />
                    <TextBlock Text="All values are editable. Hover over a control for help. Time values fit within the total duration." Visibility="{Binding IsSynthesis, Converter={StaticResource BooleanVisibility}}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Layers}" Visibility="{Binding IsSynthesis, Converter={StaticResource BooleanVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <GroupBox Header="{Binding Title}">
                                    <StackPanel>
                                        <CheckBox Content="Enable layer" IsChecked="{Binding Enabled}" />
                                        <StackPanel IsEnabled="{Binding Enabled}">
                                            <DockPanel Margin="0,3,0,6">
                                                <TextBlock Foreground="{DynamicResource TimbreBrush}" Text="Source" Width="112" VerticalAlignment="Center" />
                                                <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" AutomationProperties.Name="Layer source" />
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Parameters}" />
                                            <TextBlock Foreground="{DynamicResource PitchBrush}" Text="Sequence · semitone offsets, e.g. 0, 4, 7, 12" Margin="0,8,0,4" TextWrapping="Wrap" FontSize="12" />
                                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" AutomationProperties.Name="Sequence semitone offsets" />
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding EffectGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><GroupBox Header="{Binding Title}"><ItemsControl ItemsSource="{Binding Parameters}" /></GroupBox></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" Background="{DynamicResource ControlBorderBrush}" />
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="3. Preview and export" Style="{StaticResource SectionHeading}" />
                    <Grid>
                        <local:WaveformView Sound="{Binding Sound}" Height="210" ToolTip="Waveform of the final 16-bit PCM samples. Stereo channels are shown separately." AutomationProperties.Name="Final exported audio waveform" />
                        <Border Background="{DynamicResource PanelBrush}" Opacity="0.9">
                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsRendering}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            <TextBlock Text="Updating waveform…" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding OutputSummary}" Margin="0,10,0,6" TextWrapping="Wrap" FontWeight="SemiBold" LineHeight="22" />
                    <TextBlock Text="{Binding PlaybackLabel}" Margin="0,0,0,8" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Foreground="{DynamicResource WarningBrush}" Text="{Binding ClipWarning}" Style="{StaticResource OptionalText}" FontWeight="Bold" Margin="0,0,0,8" />
                    <GroupBox Header="Output">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource OutputBrush}" Text="Sample rate (Hz)" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding SampleRates}" SelectedItem="{Binding SampleRate}" AutomationProperties.Name="Sample rate" Margin="0,0,0,8" />
                            <TextBlock Foreground="{DynamicResource OutputBrush}" Text="Channels · 1 mono / 2 stereo" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding ChannelCounts}" SelectedItem="{Binding Channels}" AutomationProperties.Name="Output channels" Margin="0,0,0,8" />
                            <TextBlock Foreground="{DynamicResource OutputBrush}" Text="Bit depth: 16-bit PCM (fixed)" FontWeight="SemiBold" Margin="0,2,0,8" />
                            <CheckBox Foreground="{DynamicResource TimingBrush}" Content="Seamless loop" IsChecked="{Binding Loop}" ToolTip="Circular echoes and a blended seam. Export contains one cycle; enable looping in your game engine." />
                            <CheckBox Foreground="{DynamicResource OutputBrush}" Content="Normalize to −1 dBFS" IsChecked="{Binding Normalize}" ToolTip="Normalize before applying Output level. Positive output gain can still clip." />
                            <TextBlock Text="Release and echoes fit inside Duration. Loop files contain one cycle without extra silence." TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Recipe settings">
                        <StackPanel>
                            <TextBlock Text="Name" Margin="0,0,0,4" />
                            <TextBox Text="{Binding RecipeName, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" AutomationProperties.Name="Recipe name" Margin="0,0,0,8" />
                            <TextBlock Text="Seed" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Seed, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" AutomationProperties.Name="Random seed" />
                            <TextBlock Text="Same settings + seed = same sound. Save a recipe to reopen it later. Undo keeps the last 100 edits this session." TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
